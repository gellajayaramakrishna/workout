rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only someone who knows the long SPACE_ID can read or write.
    // Listing /spaces is not allowed, so the id cannot be discovered.
    match /spaces/{space}/log/{day} {
      allow read: if space.size() >= 20;
      allow write: if space.size() >= 20
                   && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                   && (request.resource == null || request.resource.data.size() <= 20);
    }
  }
}
